---
const { instanceId } = Astro.props;
const menuId = `langMenu-${instanceId}`;
---

<div
  class="section-corner-controls section-corner-controls--light section-corner-controls--reveal"
  data-section-corner-controls={instanceId}
>
  <div class="social-float">
    <a
      href="https://www.instagram.com/myperol/"
      target="_blank"
      rel="noopener"
      aria-label="Instagram"
      data-i18n-aria-label="social_instagram"
      class="social-link"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 2C4.24 2 2 4.24 2 7v10c0 2.76 2.24 5 5 5h10c2.76 0 5-2.24 5-5V7c0-2.76-2.24-5-5-5H7zm10 2a3 3 0 013 3v10a3 3 0 01-3 3H7a3 3 0 01-3-3V7a3 3 0 013-3h10zm-5 3a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6zm4.8-.9a1.1 1.1 0 11-2.2 0 1.1 1.1 0 012.2 0z" />
      </svg>
    </a>

    <a
      href="https://wa.me/34663108027"
      target="_blank"
      rel="noopener"
      aria-label="WhatsApp"
      data-i18n-aria-label="social_whatsapp"
      class="social-link"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.04 2C6.53 2 2 6.53 2 12c0 1.96.57 3.86 1.65 5.48L2 22l4.67-1.62A9.96 9.96 0 0012.04 22C17.55 22 22 17.47 22 12S17.55 2 12.04 2zm0 18a8 8 0 01-4.08-1.12l-.29-.17-2.77.96.94-2.69-.18-.3A8 8 0 1112.04 20zm4.65-5.35c-.25-.12-1.47-.72-1.7-.8-.23-.08-.4-.12-.57.12-.17.25-.65.8-.8.96-.15.17-.3.18-.55.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.1-.5.11-.11.25-.3.37-.45.12-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.12-.57-1.37-.78-1.88-.2-.48-.4-.41-.57-.42h-.49c-.17 0-.45.06-.68.32-.23.25-.9.88-.9 2.15 0 1.27.92 2.5 1.05 2.67.12.17 1.81 2.76 4.39 3.87.61.26 1.09.42 1.46.54.61.19 1.17.16 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.28z" />
      </svg>
      <span data-whatsapp-text data-i18n="whatsapp_cta"></span>
    </a>
  </div>

  <div class="language-control">
    <div class="lang-dropdown">
      <button
        class="lang-button"
        type="button"
        onclick="toggleLangMenu(this)"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls={menuId}
      >
        <span data-current-lang>ES</span>
        <span class="lang-arrow">&#9662;</span>
      </button>

      <ul class="lang-menu floating-dropdown" id={menuId} hidden>
        <li><button type="button" class="lang-option" data-lang="es" data-i18n="lang_es" onclick="selectLang('es')">Español</button></li>
        <li><button type="button" class="lang-option" data-lang="en" data-i18n="lang_en" onclick="selectLang('en')">English</button></li>
        <li><button type="button" class="lang-option" data-lang="de" data-i18n="lang_de" onclick="selectLang('de')">Deutsch</button></li>
        <li><button type="button" class="lang-option" data-lang="fr" data-i18n="lang_fr" onclick="selectLang('fr')">Français</button></li>
        <li><button type="button" class="lang-option" data-lang="ru" data-i18n="lang_ru" onclick="selectLang('ru')">Русский</button></li>
        <li><button type="button" class="lang-option" data-lang="uk" data-i18n="lang_uk" onclick="selectLang('uk')">Українська</button></li>
      </ul>
    </div>
  </div>
</div>
