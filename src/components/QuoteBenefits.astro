---
import messages from "../i18n/json/es.json";
---

<ul class="mp-benefits" aria-label={messages.calculator_benefits_aria} data-i18n-aria-label="calculator_benefits_aria" role="list">
  <li class="mp-benefits__item">
    <svg class="mp-benefits__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <circle cx="16" cy="16" r="13.5" />
      <path d="M9.5 16.5 14 21 23 11" />
    </svg>
    <span class="mp-benefits__text">
      <span data-i18n="calculator_benefit_visit">{messages.calculator_benefit_visit}</span>
    </span>
  </li>
  <li class="mp-benefits__item">
    <svg class="mp-benefits__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path d="M7 2.5h12l8 8v17a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-23a2 2 0 0 1 2-2Z" />
      <path d="M19 2.5v8h8M10 15h12M10 19h12M10 23h12" />
    </svg>
    <span class="mp-benefits__text">
      <span data-i18n="calculator_benefit_quote">{messages.calculator_benefit_quote}</span>
    </span>
  </li>
  <li class="mp-benefits__item">
    <svg class="mp-benefits__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <circle cx="16" cy="16" r="13.5" />
      <path d="M16 7.5v9l6 4" />
    </svg>
    <span class="mp-benefits__text" data-i18n="calculator_benefit_no_obligation">{messages.calculator_benefit_no_obligation}</span>
  </li>
  <li class="mp-benefits__item">
    <svg class="mp-benefits__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path d="m16 2.5 4.2 8.7 9.6 1.4-6.9 6.7 1.6 9.5-8.5-4.5-8.5 4.5 1.6-9.5-6.9-6.7 9.6-1.4Z" />
    </svg>
    <span class="mp-benefits__text" data-i18n="calculator_benefit_advice">{messages.calculator_benefit_advice}</span>
  </li>
</ul>

<style>
  .mp-benefits {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
    gap: 20px 16px;
    margin: 32px 0;
    padding: 0;
    list-style: none;
    color: #f5f5f5;
    font-family: inherit;
  }

  .mp-benefits + :global(.price-intro-direct__action) {
    margin-top: 0;
  }

  .mp-benefits__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 11px;
    min-width: 0;
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .mp-benefits__icon {
    display: block;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mp-benefits__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    max-width: 100%;
    color: #d9d9d9;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  @media (max-width: 600px), (min-width: 903px) and (max-width: 1200px) {
    .mp-benefits { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mp-benefits__item { gap: 9px; }
    .mp-benefits__icon { width: 30px; height: 30px; }
    .mp-benefits__text { font-size: 12px; }
  }

  @media (min-width: 903px) and (max-width: 1200px) {
    .mp-benefits { row-gap: 16px; }
  }
</style>
