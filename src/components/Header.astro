---
const { currentPath = "/" } = Astro.props;
const isHome = currentPath === "/";
const isServices = currentPath === "/servicios";
---

<header class="site-header" aria-label="Navegación principal" data-i18n-aria-label="nav_main_aria">
  <div class="mobile-header-bar">
    <a href="/" class="mobile-logo" aria-label="MyPerol">
      <img src="/assets/logo/logo-blanco.png" alt="MyPerol" />
    </a>

    <div class="mobile-header-actions">
      <div class="language-control">
        <div class="lang-dropdown">
          <button
            class="lang-button"
            id="langToggle"
            type="button"
            onclick="toggleLangMenu()"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="langMenu"
          >
            <span id="currentLang">ES</span>
            <span class="lang-arrow">▾</span>
          </button>

          <ul class="lang-menu floating-dropdown" id="langMenu" hidden>
            <li>
              <button type="button" class="lang-option" data-lang="es" data-i18n="lang_es" onclick="selectLang('es')">Español</button>
            </li>
            <li>
              <button type="button" class="lang-option" data-lang="en" data-i18n="lang_en" onclick="selectLang('en')">English</button>
            </li>
            <li>
              <button type="button" class="lang-option" data-lang="de" data-i18n="lang_de" onclick="selectLang('de')">Deutsch</button>
            </li>
            <li>
              <button type="button" class="lang-option" data-lang="fr" data-i18n="lang_fr" onclick="selectLang('fr')">Français</button>
            </li>
            <li>
              <button type="button" class="lang-option" data-lang="ru" data-i18n="lang_ru" onclick="selectLang('ru')">Русский</button>
            </li>
            <li>
              <button type="button" class="lang-option" data-lang="uk" data-i18n="lang_uk" onclick="selectLang('uk')">Українська</button>
            </li>
          </ul>
        </div>
      </div>

      <div class="mobile-nav-dropdown">
        <button
          class="mobile-menu-button"
          id="mobileMenuToggle"
          type="button"
          onclick="toggleMobileMenu()"
          aria-label="Abrir menú"
          data-i18n-aria-label="mobile_menu_open"
          aria-expanded="false"
          aria-controls="primaryNav"
        >
          <span></span>
          <span></span>
        </button>

        <nav class="floating-nav floating-dropdown" id="primaryNav" aria-label="Secciones principales" data-i18n-aria-label="nav_sections_aria" hidden>
          <a href="/" class="floating-nav-link" aria-current={isHome ? "page" : undefined} onclick="closeMobileMenu()" data-i18n="nav_home">Home</a>
          <a href="/servicios" class="floating-nav-link" aria-current={isServices ? "page" : undefined} onclick="closeMobileMenu()" data-i18n="nav_services">Servicios</a>
          <a href="/#precios" class="floating-nav-link" onclick="closeMobileMenu()" data-i18n="nav_prices">Precios</a>
          <a href="/#mp-systems" class="floating-nav-link" onclick="closeMobileMenu()" data-i18n="nav_mp_systems">MP Systems</a>
        </nav>
      </div>
    </div>
  </div>

  <nav class="floating-nav desktop-nav" aria-label="Secciones principales" data-i18n-aria-label="nav_sections_aria">
    <a href="/" class="floating-nav-link" aria-current={isHome ? "page" : undefined} onclick="closeMobileMenu()" data-i18n="nav_home">Home</a>
    <a href="/servicios" class="floating-nav-link" aria-current={isServices ? "page" : undefined} onclick="closeMobileMenu()" data-i18n="nav_services">Servicios</a>
    <a href="/#precios" class="floating-nav-link" onclick="closeMobileMenu()" data-i18n="nav_prices">Precios</a>
    <a href="/#mp-systems" class="floating-nav-link" onclick="closeMobileMenu()" data-i18n="nav_mp_systems">MP Systems</a>
  </nav>
</header>
