---
import LanguageControl from "./LanguageControl.astro";
const { currentPath = "/" } = Astro.props;
const isHome = currentPath === "/";
const isServices = currentPath === "/servicios";
const isPrices = currentPath === "/precios";
---

<header class="site-header" aria-label="Navegación principal" data-i18n-aria-label="nav_main_aria">
  <div class="mobile-header-bar">
    <a href="/" class="mobile-logo" aria-label="MyPerol">
      <img src="/assets/logo/logo-blanco.webp" width="512" height="84" decoding="async" alt="MyPerol" />
    </a>

    <div class="mobile-header-actions">
      <LanguageControl primary />

      <div class="mobile-nav-dropdown">
        <button
          class="mobile-menu-button"
          id="mobileMenuToggle"
          type="button"
          onclick="toggleMobileMenu()"
          aria-label="Abrir menú"
          data-i18n-aria-label="mobile_menu_open"
          aria-expanded="false"
          aria-controls="primaryNav"
        >
          <span></span>
          <span></span>
        </button>

        <nav class="floating-nav floating-dropdown" id="primaryNav" aria-label="Secciones principales" data-i18n-aria-label="nav_sections_aria" hidden>
          <a href="/" class="floating-nav-link" aria-current={isHome ? "page" : undefined} onclick="closeMobileMenu()" data-i18n="nav_home">Inicio</a>
          <a href="/#servicios" class="floating-nav-link" aria-current={isServices ? "page" : undefined} onclick="closeMobileMenu()" data-i18n="nav_services">Servicios</a>
          <a href="/#mp-systems" class="floating-nav-link" onclick="closeMobileMenu()" data-i18n="nav_mp_systems">MP Systems</a>
          <a href="/#calculadora" class="floating-nav-link" aria-current={isPrices ? "page" : undefined} onclick="closeMobileMenu()" data-i18n="nav_prices">Calculadora</a>
        </nav>
      </div>
    </div>
  </div>

  <nav class="floating-nav desktop-nav" aria-label="Secciones principales" data-i18n-aria-label="nav_sections_aria">
    <a href="/" class="floating-nav-link floating-nav-home" aria-label="Inicio" data-i18n-aria-label="nav_home" aria-current={isHome ? "page" : undefined} onclick="closeMobileMenu()">
      <img class="floating-nav-home-logo" src="/assets/logo/logo-myperol-gota.webp" width="160" height="160" decoding="async" alt="" aria-hidden="true" />
    </a>
    <a href="/#servicios" class="floating-nav-link" aria-current={isServices ? "page" : undefined} onclick="closeMobileMenu()"><span class="floating-nav-label" data-i18n="nav_services">Servicios</span></a>
    <a href="/#mp-systems" class="floating-nav-link" onclick="closeMobileMenu()"><span class="floating-nav-label" data-i18n="nav_mp_systems">MP Systems</span></a>
    <a href="/#calculadora" class="floating-nav-link" aria-current={isPrices ? "page" : undefined} onclick="closeMobileMenu()"><span class="floating-nav-label" data-i18n="nav_prices">Calculadora</span></a>
  </nav>
</header>
