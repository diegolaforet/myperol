---
const { currentPath = "/" } = Astro.props;
const isHome = currentPath === "/";
---

<header class="site-header" aria-label="Navegacion principal">
  <div class="mobile-header-bar">
    <a href="/" class="mobile-logo" aria-label="MyPerol">
      <img src="/assets/logo/logo.JPG" alt="MyPerol" />
    </a>

    <div class="mobile-header-actions">
      <div class="language-control">
        <div class="lang-dropdown">
          <button
            class="lang-button"
            id="langToggle"
            type="button"
            onclick="toggleLangMenu()"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="langMenu"
          >
            <span id="currentLang">ES</span>
            <span class="lang-arrow">▾</span>
          </button>

          <ul class="lang-menu" id="langMenu" hidden>
            <li>
              <button type="button" class="lang-option" data-lang="es" onclick="selectLang('es')">Español</button>
            </li>
            <li>
              <button type="button" class="lang-option" data-lang="en" onclick="selectLang('en')">English</button>
            </li>
            <li>
              <button type="button" class="lang-option" data-lang="de" onclick="selectLang('de')">Deutsch</button>
            </li>
            <li>
              <button type="button" class="lang-option" data-lang="fr" onclick="selectLang('fr')">Français</button>
            </li>
            <li>
              <button type="button" class="lang-option" data-lang="ru" onclick="selectLang('ru')">Русский</button>
            </li>
            <li>
              <button type="button" class="lang-option" data-lang="uk" onclick="selectLang('uk')">Українська</button>
            </li>
          </ul>
        </div>
      </div>

      <div class="mobile-nav-dropdown">
        <button
          class="mobile-menu-button"
          id="mobileMenuToggle"
          type="button"
          onclick="toggleMobileMenu()"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="primaryNav"
        >
          <span></span>
          <span></span>
        </button>

        <nav class="floating-nav" id="primaryNav" aria-label="Secciones principales">
          <a href="/" class="floating-nav-link" aria-current={isHome ? "page" : undefined} onclick="closeMobileMenu()">Home</a>
          <a href="#servicios" class="floating-nav-link" onclick="closeMobileMenu()">Servicios</a>
          <a href="#precios" class="floating-nav-link" onclick="closeMobileMenu()">Precios</a>
          <a href="#mp-systems" class="floating-nav-link" onclick="closeMobileMenu()">MP Systems</a>
        </nav>
      </div>
    </div>
  </div>

  <nav class="floating-nav desktop-nav" aria-label="Secciones principales">
    <a href="/" class="floating-nav-link" aria-current={isHome ? "page" : undefined} onclick="closeMobileMenu()">Home</a>
    <a href="#servicios" class="floating-nav-link" onclick="closeMobileMenu()">Servicios</a>
    <a href="#precios" class="floating-nav-link" onclick="closeMobileMenu()">Precios</a>
    <a href="#mp-systems" class="floating-nav-link" onclick="closeMobileMenu()">MP Systems</a>
  </nav>
</header>
