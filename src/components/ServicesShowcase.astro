---
import ServiceCard from "../components/ServiceCard.astro";
import { homeServices } from "../data/services";
import SectionCornerControls from "./SectionCornerControls.astro";
---

<section
  id="servicios"
  class="feature-cards services-feature-cards home-services-showcase"
  aria-label="Servicios MyPerol"
  data-i18n-aria-label="feature_cards_aria"
>
  <SectionCornerControls instanceId="services" />

  <div class="feature-cards-header">
    <h2 id="services-feature-heading" class="services-feature-heading" data-i18n="feature_cards_heading">Explora posibilidades para tu espacio.</h2>
    <div class="services-feature-subtitle">
      <p id="services-performance-copy"><b>Cada espacio exige un nivel de rendimiento diferente.</b></p>
      <p id="services-performance-copy-2">
        Nuestros sistemas epoxídicos <b>(MP SYSTEM)</b> han sido desarrollados para responder a las exigencias específicas de cada entorno, combinando resistencia, diseño y facilidad de mantenimiento para ofrecer el máximo rendimiento en distintos entornos de uso.
      </p>
    </div>
  </div>

  <div class="feature-cards-shell">
    <div class="feature-cards-track">
      {homeServices.map(service => <ServiceCard service={service} home />)}
    </div>

    <button class="feature-cards-arrow feature-cards-prev" type="button" aria-label="Ver tarjetas anteriores" data-i18n-aria-label="carousel_prev" data-carousel-prev hidden>
      <span aria-hidden="true">&lsaquo;</span>
    </button>

    <button class="feature-cards-arrow feature-cards-next" type="button" aria-label="Ver mas tarjetas" data-i18n-aria-label="carousel_next" data-carousel-next hidden>
      <span aria-hidden="true">&rsaquo;</span>
    </button>

    <div class="feature-cards-dots home-carousel-dots-on-light" aria-hidden="true" data-carousel-dots></div>
  </div>
</section>

<script>
  import { initializeServiceCards } from "../scripts/service-dialog";
  initializeServiceCards(".home-services-showcase .service-card-expandable", "Calcular precio");
</script>
