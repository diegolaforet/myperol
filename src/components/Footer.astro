---
import SocialLinks from "./SocialLinks.astro";
import { contact } from "../data/contact";
import messages from "../i18n/json/es.json";

const navigation = [
  { href: "/", key: "nav_home" },
  { href: "/#servicios", key: "nav_services" },
  { href: "/#mp-systems", key: "nav_mp_systems" },
  { href: "/#calculadora", key: "nav_prices" },
] as const;
const legalLabels = ["footer_legal_notice", "footer_privacy", "footer_cookies"] as const;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="/" aria-label="MyPerol">
        <img src="/assets/logo/logo-negro.png" width="1275" height="220" alt="MyPerol" loading="lazy" decoding="async" />
      </a>
      <p data-i18n="footer_tagline">{messages.footer_tagline}</p>
    </div>

    <div>
      <h2 data-i18n="footer_contact">{messages.footer_contact}</h2>
      <address class="site-footer__contact">
        <a href={`tel:${contact.phone}`}>{contact.phoneLabel}</a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <span data-i18n="footer_location">{messages.footer_location}</span>
      </address>
    </div>

    <nav aria-labelledby="footer-navigation-title">
      <h2 id="footer-navigation-title" data-i18n="footer_navigation">{messages.footer_navigation}</h2>
      <ul>
        {navigation.map(({ href, key }) => <li><a href={href} data-i18n={key}>{messages[key]}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 data-i18n="footer_legal_social">{messages.footer_legal_social}</h2>
      <ul class="site-footer__legal">
        {/* Legal documents are not published yet; do not create dead links. */}
        {legalLabels.map(key => <li><span data-i18n={key}>{messages[key]}</span></li>)}
      </ul>
      <SocialLinks inline />
    </div>
  </div>

  <div class="site-footer__bottom">
    <small data-i18n="footer_copyright" data-i18n-params={JSON.stringify({ year })}>{messages.footer_copyright.replace("{year}", String(year))}</small>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    width: 100%;
    padding: 72px var(--edge-gutter) 28px;
    background: var(--palette-white);
    color: var(--palette-label);
    border-top: 1px solid var(--palette-tone-13);
    font-size: 14px;
    line-height: 1.6;
    text-align: left;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1.15fr) minmax(0, .85fr) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }
  .site-footer__grid > * { min-width: 0; }
  .site-footer__logo { display: inline-block; width: 204px; max-width: 100%; }
  .site-footer__logo img { display: block; width: 100%; height: auto; }
  .site-footer__brand p { max-width: 28ch; margin: 24px 0 0; font-size: 15px; line-height: 1.7; text-align: left; }
  .site-footer h2 { margin: 0 0 20px; color: var(--palette-ink); font-size: 14px; line-height: 1.6; font-weight: 500; text-wrap: wrap; }
  .site-footer ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .site-footer__contact { display: grid; justify-items: start; gap: 10px; font-style: normal; }
  .site-footer a { color: inherit; text-decoration: none; overflow-wrap: anywhere; transition: color 180ms ease; }
  .site-footer a:is(:hover, :focus-visible) { color: var(--palette-ink); }
  .site-footer a:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .site-footer__legal { color: var(--palette-muted); }
  .site-footer__bottom { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--palette-tone-13); }
  .site-footer__bottom small { display: block; font-size: 12px; line-height: 1.6; }
  @media (max-width: 1100px) {
    .site-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  }
  @media (max-width: 640px) {
    .site-footer { padding-block: 48px 24px; }
    .site-footer__grid { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .site-footer__logo { width: 190px; }
    .site-footer__brand p { max-width: 34ch; margin-top: 20px; }
    .site-footer h2 { margin-bottom: 14px; }
    .site-footer__bottom { margin-top: 36px; padding-top: 24px; }
  }
</style>
