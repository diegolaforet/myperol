---
import SectionCornerControls from "./SectionCornerControls.astro";
import messages from "../i18n/json/es.json";
---
<section id="calculadora" class="prices-page" aria-label={messages.calculator_aria} data-i18n-aria-label="calculator_aria">
    <SectionCornerControls instanceId="calculator" tone="dark" />
    <header class="prices-section-heading">
      <p class="prices-section-eyebrow" data-i18n="calculator_eyebrow">{messages.calculator_eyebrow}</p>
      <h2 data-i18n="calculator_heading">{messages.calculator_heading}</h2>
      <p class="prices-section-intro" data-i18n="calculator_intro">{messages.calculator_intro}</p>
    </header>
    <section class="prices-hero" aria-label={messages.calculator_prices_aria} data-i18n-aria-label="calculator_prices_aria">
    </section>

    <section id="prices-calculator-card" class="prices-card service-expanded-card" aria-label={messages.calculator_estimate_aria} data-i18n-aria-label="calculator_estimate_aria" data-price-card data-step="1">
      <button class="price-back-button" type="button" aria-label={messages.common_back} data-i18n-aria-label="common_back" data-price-back hidden>
        <span aria-hidden="true">&larr;</span>
        <span class="price-back-label" data-i18n="common_back">{messages.common_back}</span>
      </button>

      <aside class="price-intro-direct" data-price-direct-panel>
        <p class="price-intro-direct__kicker" data-i18n="calculator_direct_kicker">{messages.calculator_direct_kicker}</p>
        <h3 data-i18n="calculator_direct_title">{messages.calculator_direct_title}</h3>
        <p data-i18n="calculator_direct_copy">{messages.calculator_direct_copy}</p>
        <button class="price-intro-direct__action" type="button" data-price-direct-open>
          <span data-i18n="calculator_direct_action">{messages.calculator_direct_action}</span>
          <span aria-hidden="true">&rarr;</span>
        </button>
      </aside>

      <div class="service-expanded-media" data-price-media>
        <div class="service-expanded-media-frame">
          <img src="/assets/card-images/services/home-card.webp" width="1200" height="900" loading="lazy" decoding="async" alt="" aria-hidden="true" />
        </div>
      </div>

      <div class="service-expanded-content prices-step-content">
        <form class="price-direct-contact" data-price-direct-form hidden>
          <button class="price-direct-contact__back" type="button" data-price-direct-close>
            <span aria-hidden="true">&larr;</span>
            <span data-i18n="calculator_direct_back">{messages.calculator_direct_back}</span>
          </button>
          <p class="price-direct-contact__kicker" data-i18n="calculator_direct_form_kicker">{messages.calculator_direct_form_kicker}</p>
          <h3 id="priceDirectContactTitle" data-i18n="calculator_direct_form_title">{messages.calculator_direct_form_title}</h3>
          <p class="price-direct-contact__copy" data-i18n="calculator_direct_form_copy">{messages.calculator_direct_form_copy}</p>
          <div class="price-direct-contact__fields">
            <label>
              <span data-i18n="form_first_name">{messages.form_first_name}</span>
              <input type="text" name="direct-full-name" autocomplete="name" required data-price-direct-name />
            </label>
            <label>
              <span data-i18n="form_last_name">{messages.form_last_name}</span>
              <input type="text" name="direct-last-name" autocomplete="family-name" required data-price-direct-last-name />
            </label>
            <label>
              <span data-i18n="form_email">{messages.form_email}</span>
              <input type="email" name="direct-email" autocomplete="email" required data-price-direct-email />
            </label>
            <label class="price-direct-contact__phone-label">
              <span data-i18n="form_phone">{messages.form_phone}</span>
              <span class="price-phone-field price-direct-contact__phone">
                <span class="phone-prefix-select" data-price-direct-phone-prefix-select>
                  <input type="hidden" name="direct-phone-prefix" value="+34" data-price-direct-phone-prefix-value />
                  <button class="phone-prefix-button" type="button" aria-label={messages.form_phone_prefix} data-i18n-aria-label="form_phone_prefix" aria-expanded="false" data-price-direct-phone-prefix-button>
                    <span data-price-direct-phone-prefix-current>&#127466;&#127480; +34</span>
                    <span aria-hidden="true">&#9662;</span>
                  </button>
                  <span class="phone-prefix-menu" role="listbox" data-price-direct-phone-prefix-menu hidden></span>
                </span>
                <input type="tel" name="direct-phone" autocomplete="tel" required data-price-direct-phone />
              </span>
            </label>
            <label class="price-direct-contact__message">
              <span data-i18n="form_message">{messages.form_message}</span>
              <textarea name="direct-message" rows="3" required data-price-direct-message></textarea>
            </label>
          </div>
          <button class="price-direct-contact__submit" type="submit" data-price-direct-submit>
            <span data-i18n="calculator_direct_submit">{messages.calculator_direct_submit}</span>
            <span aria-hidden="true">&rarr;</span>
          </button>
          <p class="price-direct-contact__status" aria-live="polite" data-price-direct-status></p>
        </form>

        <p class="service-expanded-label" data-price-label>MyPerol</p>
        <h3 class="service-expanded-title" data-price-title data-i18n="calculator_title_intro">{messages.calculator_title_intro}</h3>
        <p class="service-expanded-copy" data-price-copy data-i18n="calculator_copy_intro">{messages.calculator_copy_intro}</p>

        <div class="price-space-options" data-price-options hidden>
          <button class="price-space-option" type="button" data-space="vivienda"><span data-i18n="space_home">{messages.space_home}</span></button>
          <button class="price-space-option" type="button" data-space="garaje"><span data-i18n="space_garage">{messages.space_garage}</span></button>
          <button class="price-space-option" type="button" data-space="local-comercial"><span data-i18n="space_business">{messages.space_business}</span></button>
          <button class="price-space-option" type="button" data-space="industria"><span data-i18n="space_industry">{messages.space_industry}</span></button>
          <button class="price-space-option" type="button" data-space="exterior"><span data-i18n="space_outdoor">{messages.space_outdoor}</span></button>
        </div>

        <div class="price-surface-step" data-price-surface-step hidden>
          <p class="price-step-question" data-i18n="calculator_surface_question">{messages.calculator_surface_question}</p>
          <label class="price-surface-field">
            <span class="visually-hidden" data-i18n="calculator_surface_label">{messages.calculator_surface_label}</span>
            <input
              type="text"
              inputmode="numeric"
              pattern="[0-9]*"
              placeholder={messages.calculator_surface_placeholder}
              data-i18n-placeholder="calculator_surface_placeholder"
              data-price-surface-input
            />
          </label>
          <p class="price-surface-error" data-price-surface-error hidden data-i18n="calculator_surface_error">{messages.calculator_surface_error}</p>
        </div>

        <div class="price-support-options" data-price-support-options hidden>
          <button class="price-space-option" type="button" data-support="hormigon" data-i18n="support_concrete">{messages.support_concrete}</button>
          <button class="price-space-option" type="button" data-support="mortero-autonivelante" data-i18n="support_screed">{messages.support_screed}</button>
          <button class="price-space-option" type="button" data-support="ceramica-baldosa" data-i18n="support_tiles">{messages.support_tiles}</button>
          <button class="price-space-option" type="button" data-support="otro" data-i18n="support_other">{messages.support_other}</button>
        </div>

        <div class="price-ceramic-step" data-price-ceramic-step hidden>
          <button class="price-space-option price-long-option" type="button" data-ceramic-removal="no">
            <span data-i18n="ceramic_keep">{messages.ceramic_keep}</span>
            <small data-i18n="ceramic_keep_copy">{messages.ceramic_keep_copy}</small>
          </button>
          <button class="price-space-option price-long-option" type="button" data-ceramic-removal="si">
            <span data-i18n="ceramic_remove">{messages.ceramic_remove}</span>
            <small data-i18n="ceramic_remove_copy">{messages.ceramic_remove_copy}</small>
          </button>
          <button class="price-help-trigger" type="button" data-price-help-open>
            <span data-i18n="common_help">{messages.common_help}</span> <span aria-hidden="true">?</span>
          </button>
        </div>

        <div class="price-condition-step" data-price-condition-step hidden>
          <button class="price-space-option price-long-option" type="button" data-condition="excelente">
            <span class="price-condition-label price-condition-label-excellent" data-i18n="condition_excellent">{messages.condition_excellent}</span>
            <small data-i18n="condition_excellent_copy">{messages.condition_excellent_copy}</small>
          </button>
          <button class="price-space-option price-long-option" type="button" data-condition="buen-estado">
            <span class="price-condition-label price-condition-label-good" data-i18n="condition_good">{messages.condition_good}</span>
            <small data-i18n="condition_good_copy">{messages.condition_good_copy}</small>
          </button>
          <button class="price-space-option price-long-option" type="button" data-condition="pequenas-reparaciones">
            <span class="price-condition-label price-condition-label-minor" data-i18n="condition_minor">{messages.condition_minor}</span>
            <small data-i18n="condition_minor_copy">{messages.condition_minor_copy}</small>
          </button>
          <button class="price-space-option price-long-option" type="button" data-condition="reparacion-importante">
            <span class="price-condition-label price-condition-label-major" data-i18n="condition_major">{messages.condition_major}</span>
            <small data-i18n="condition_major_copy">{messages.condition_major_copy}</small>
          </button>
          <button class="price-help-trigger" type="button" data-price-condition-help-open>
            <span data-i18n="common_help">{messages.common_help}</span> <span aria-hidden="true">?</span>
          </button>
        </div>

        <div class="price-result-step" data-price-result-step hidden>
          <div class="price-result-overview">
          <p class="price-result-kicker" data-i18n="result_kicker">{messages.result_kicker}</p>
          <h3 data-i18n="result_heading">{messages.result_heading}</h3>
          <div class="price-result-range">
            <p data-i18n-template="result_intro">El precio de la instalación del sistema MP SYSTEM, para tu <span data-price-result-space data-i18n-slot="space" data-i18n="space_home">{messages.space_home}</span>, oscila entre:</p>
            <strong class="price-result-amount" data-price-result-amount>1000 €</strong>
          </div>
          </div>

          <div class="price-result-details">

          <section class="price-result-panel">
            <h4 class="price-result-panel-title">
              <span data-i18n="result_now">{messages.result_now}</span>
              <span class="price-result-kicker price-result-free" data-i18n="result_free">{messages.result_free}</span>
            </h4>
            <p data-i18n="result_now_copy">{messages.result_now_copy}</p>
          </section>

          <section class="price-result-panel price-result-contact">
            <h4 data-i18n="result_start">{messages.result_start}</h4>
            <p data-i18n="result_start_copy">{messages.result_start_copy}</p>
          </section>

          <form class="price-result-form">
            <label>
              <span class="visually-hidden" data-i18n="form_name">{messages.form_name}</span>
              <input
                type="text"
                name="full-name"
                autocomplete="name"
                placeholder={messages.form_name}
                data-i18n-placeholder="form_name"
                data-price-result-name
              />
            </label>
            <label>
              <span class="visually-hidden" data-i18n="form_phone">{messages.form_phone}</span>
              <span class="price-phone-field">
                <span class="phone-prefix-select" data-phone-prefix-select>
                  <input type="hidden" name="phone-prefix" value="+34" data-phone-prefix-value />
                  <button class="phone-prefix-button" type="button" aria-label={messages.form_phone_prefix} data-i18n-aria-label="form_phone_prefix" aria-expanded="false" data-phone-prefix-button>
                    <span data-phone-prefix-current>&#127466;&#127480; +34</span>
                    <span aria-hidden="true">&#9662;</span>
                  </button>
                  <span class="phone-prefix-menu" role="listbox" data-phone-prefix-menu hidden></span>
                </span>
                <input
                  type="tel"
                  name="phone"
                  autocomplete="tel"
                  placeholder={messages.form_phone}
                  data-i18n-placeholder="form_phone"
                  data-price-result-phone
                />
              </span>
            </label>
          </form>

          <section class="price-result-panel">
            <h4 data-i18n="result_next">{messages.result_next}</h4>
            <ul>
              <li data-i18n="result_next_contact">{messages.result_next_contact}</li>
              <li data-i18n="result_next_visit">{messages.result_next_visit}</li>
              <li data-i18n="result_next_quote">{messages.result_next_quote}</li>
            </ul>
            <p data-i18n="result_next_copy">{messages.result_next_copy}</p>
          </section>

          <button class="service-expanded-action price-result-action" type="button" data-price-result-submit disabled>
            <span data-i18n="result_submit">{messages.result_submit}</span>
          </button>
          <p class="price-result-submit-status" data-price-result-status aria-live="polite"></p>
          </div>
        </div>
        <div class="prices-card-footer">
          <button class="service-expanded-composition prices-step-action" type="button" data-price-action>
            <span class="composition-shift-label" data-price-action-label data-i18n="calculator_start">{messages.calculator_start}</span>
            <span class="composition-shift-arrow" aria-hidden="true">&rarr;</span>
          </button>
          <div class="prices-progress-dots home-carousel-dots-on-light" aria-label="Paso 1 de 5" data-i18n-aria-label="calculator_progress" data-i18n-params='{"step":1,"total":5}' data-price-progress>
            <span class="feature-cards-dot is-active" aria-hidden="true" data-price-dot></span>
            <span class="feature-cards-dot" aria-hidden="true" data-price-dot></span>
            <span class="feature-cards-dot" aria-hidden="true" data-price-dot></span>
            <span class="feature-cards-dot" aria-hidden="true" data-price-dot></span>
            <span class="feature-cards-dot price-extra-dot" aria-hidden="true" data-price-extra-dot hidden></span>
            <span class="feature-cards-dot" aria-hidden="true" data-price-dot></span>
          </div>
        </div>
      </div>
    </section>

    <section class="price-estimate-stage" aria-live="polite" data-price-estimate hidden>
      <article class="price-estimate-card">
        <span class="price-estimate-kicker" data-i18n="estimate_kicker">{messages.estimate_kicker}</span>
        <p data-i18n="estimate_title">{messages.estimate_title}</p>
        <span class="price-estimate-status" data-i18n="estimate_status">{messages.estimate_status}</span>
        <div class="price-estimate-amount" data-price-estimate-amount>130 €</div>
      </article>
    </section>

  </section>

  <div class="price-help-overlay" data-price-help-overlay hidden>
    <article class="price-help-modal" role="dialog" aria-modal="true" aria-labelledby="priceHelpTitle">
      <h2 id="priceHelpTitle" data-price-help-title></h2>
      <div data-price-help-body></div>
    </article>
  </div>

  <script>
    import "../scripts/calculator";
  </script>
