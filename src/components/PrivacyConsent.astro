---
import messages from "../i18n/json/es.json";
interface Props { id: string; }
const { id } = Astro.props;
---

<div class="privacy-consent" data-privacy-consent>
  <input id={id} type="checkbox" name="privacy-accepted" value="true" required data-privacy-checkbox />
  <label for={id} data-i18n-template="privacy_acceptance">
    {messages.privacy_acceptance.split("{policy}")[0]}<a
      href="/politica-privacidad"
      target="_blank"
      rel="noopener noreferrer"
      data-i18n-slot="policy"
      data-i18n="footer_privacy"
      aria-label={messages.privacy_link_aria}
      data-i18n-aria-label="privacy_link_aria"
    >{messages.footer_privacy}</a>{messages.privacy_acceptance.split("{policy}")[1]}
  </label>
</div>

<style>
  .privacy-consent {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: start;
    gap: 4px 10px;
    margin-top: 12px;
    --contact-reveal-index: 7;
  }
  :global(.prices-card) .privacy-consent input[type="checkbox"] {
    appearance: auto;
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    max-height: 18px;
    margin: 5px 0 0;
    padding: 0;
    border-radius: 3px;
    box-shadow: none;
    accent-color: var(--palette-graphite);
    cursor: pointer;
  }
  :global(.prices-card) .privacy-consent label {
    display: block;
    margin: 0;
    padding-block: 4px;
    color: var(--color-card-muted);
    font: 400 12px/1.6 var(--font-ui);
    text-align: left;
    overflow-wrap: anywhere;
    cursor: pointer;
  }
  .privacy-consent a { color: var(--palette-ink); text-decoration: underline; text-underline-offset: 3px; }
  .privacy-consent a:hover { text-decoration-thickness: 2px; }
  .privacy-consent a:focus-visible,
  :global(.prices-card) .privacy-consent input:focus-visible { outline: 2px solid var(--palette-label); outline-offset: 3px; }
  .privacy-consent :global(.price-direct-contact__field-error) { grid-column: 2; }
  @media (max-width: 902px) {
    .privacy-consent { min-height: 44px; }
    :global(.prices-card) .privacy-consent label { font-size: 13px; }
  }
</style>
