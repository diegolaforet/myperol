---
import messages from "../i18n/json/es.json";
import SocialLinks from "../components/SocialLinks.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fontsource-variable/lexend";
import latinFont from "@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/design.css";

const {
  titleKey = "page_title",
  descriptionKey = "page_description",
  isHome = false,
  bodyClass = "",
} = Astro.props;


const title = messages[titleKey];
const description = messages[descriptionKey];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://myperol.es");
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
    {isHome && <link rel="preload" href="/assets/videos/hero-poster.webp" as="image" fetchpriority="high" />}
    <title data-i18n={titleKey}>{title}</title>
    <meta name="description" content={description} data-i18n-content={descriptionKey} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} data-i18n-content={titleKey} />
    <meta property="og:description" content={description} data-i18n-content={descriptionKey} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="MyPerol" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-i18n-content={titleKey} />
    <meta name="twitter:description" content={description} data-i18n-content={descriptionKey} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script>
      import "../scripts/site";
    </script>
  </head>

  <body class={bodyClass || undefined}>
    <Header currentPath={Astro.url.pathname} />
    <slot />
    <Footer />

    <SocialLinks primary />
  </body>
</html>
