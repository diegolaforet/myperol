---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionCornerControls from "../components/SectionCornerControls.astro";
import SplineScroll from "../components/SplineScroll.astro";
---

<BaseLayout
  title="MyPerol - EPOXI"
  description="Página informativa de MyPerol."
  isHome
>
  <main class="home-page">
    <section class="hero-placeholder home-video-hero" aria-label="MyPerol">
      <video
        class="home-video-hero__media"
        src="/assets/videos/video-intro-index.mov"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      ></video>
    </section>

    <section class="feature-cards home-primary-cards" aria-label="Novedades MyPerol" data-i18n-aria-label="feature_cards_aria" data-entry-scroll-target>
      <SectionCornerControls instanceId="primary-cards" />

      <div class="feature-cards-header home-primary-cards-header">
        <p class="home-primary-cards-heading" data-i18n="home_feature_cards_heading">La sensación de un espacio transformado.</p>
      </div>

      <div class="feature-cards-shell home-primary-cards-shell">
        <div class="feature-cards-track home-primary-cards-track" id="featureCardsTrack">
          <article class="feature-card home-primary-card">
            <p class="home-primary-card-copy" data-i18n="home_primary_card_1_text">Un suelo MyPerol no solo cambia la superficie, cambia la percepción COMPLETA del lugar.</p>
            <svg class="home-primary-card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="percepcion-title percepcion-desc">
              <title id="percepcion-title" data-i18n="home_primary_card_1_icon_title">Percepción transformada</title>
              <desc id="percepcion-desc" data-i18n="home_primary_card_1_icon_desc">Un ojo sobre una superficie continua representa cómo el pavimento transforma la percepción del espacio.</desc>
              <path d="M8 24.5C13.8 16.8 21.9 13 32 13s18.2 3.8 24 11.5C50.2 32.2 42.1 36 32 36S13.8 32.2 8 24.5Z"></path>
              <circle cx="32" cy="24.5" r="6.5"></circle>
              <circle cx="32" cy="24.5" r="2" fill="currentColor" stroke="none"></circle>
              <path d="m15 43 17-6 17 6-17 8-17-8Z"></path>
              <path d="M32 51v5M15 43v5l17 8 17-8v-5"></path>
              <path d="M50 8v7M46.5 11.5h7"></path>
            </svg>
          </article>
          <article class="feature-card home-primary-card">
            <p class="home-primary-card-copy" data-i18n="home_primary_card_2_text">La ausencia de juntas, la continuidad visual y el acabado uniforme generan una sensación de amplitud, orden, comodidad y limpieza inexplicable desde el primer momento.</p>
            <svg class="home-primary-card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="continuidad-title continuidad-desc">
              <title id="continuidad-title" data-i18n="home_primary_card_2_icon_title">Continuidad y amplitud</title>
              <desc id="continuidad-desc" data-i18n="home_primary_card_2_icon_desc">Una superficie continua con flechas abiertas representa ausencia de juntas, amplitud, orden y limpieza.</desc>
              <path d="M12 16h40v29H12z"></path>
              <path d="m12 45 10-12h20l10 12"></path>
              <path d="M22 33h20"></path>
              <path d="M27 25H16M16 25l4-4M16 25l4 4"></path>
              <path d="M37 25h11M48 25l-4-4M48 25l-4 4"></path>
              <path d="M18 51h28"></path>
              <path d="M22 56h20"></path>
              <path d="M48 9v5M45.5 11.5h5"></path>
            </svg>
          </article>
          <article class="feature-card home-primary-card">
            <p class="home-primary-card-copy" data-i18n="home_primary_card_3_text">Al caminar sobre él se percibe una superficie sólida, continua y cuidada, con un acabado pensado para transmitir calidad tanto a la vista como la sensación de caminar por él.</p>
            <svg class="home-primary-card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="solidez-title solidez-desc">
              <title id="solidez-title" data-i18n="home_primary_card_3_icon_title">Solidez y confort</title>
              <desc id="solidez-desc" data-i18n="home_primary_card_3_icon_desc">Una superficie continua con un acabado suave se apoya sobre una base sólida y estable.</desc>
              <path d="M43 9v10M38 14h10"></path>
              <path d="M51 21v5M48.5 23.5h5"></path>
              <path d="m8 40 24-10 24 10-24 12L8 40Z"></path>
              <path d="M18.5 41c5.2-4.4 9.8-5.7 14.3-3.4 4.3 2.1 8.2 1.1 12.7-2.4"></path>
              <path d="M8 46.5 32 58l24-11.5"></path>
              <path d="M32 52v6"></path>
            </svg>
          </article>
          <article class="feature-card home-primary-card">
            <p class="home-primary-card-copy" data-i18n="home_primary_card_4_text">Los espacios ganan presencia y el suelo deja de ser un elemento funcional para convertirse en la parte protagonista del diseño y ambiente.</p>
            <svg class="home-primary-card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="protagonista-title protagonista-desc">
              <title id="protagonista-title" data-i18n="home_primary_card_4_icon_title">El suelo como protagonista</title>
              <desc id="protagonista-desc" data-i18n="home_primary_card_4_icon_desc">Un espacio arquitectónico conduce la mirada hacia una superficie central iluminada.</desc>
              <path d="M10 9.5h44v43H10z"></path>
              <path d="M10 29h44"></path>
              <path d="M10 52.5 24 29h16l14 23.5"></path>
              <path d="M25 42.5c4.2-2.7 9.8-2.7 14 0"></path>
              <circle cx="32" cy="37.2" r="2.2" fill="currentColor" stroke="none"></circle>
              <path d="M32 15v11M27.5 17.5 32 26l4.5-8.5"></path>
            </svg>
          </article>
          <article class="feature-card home-primary-card">
            <p class="home-primary-card-copy" data-i18n="home_primary_card_5_text">Porque un buen pavimento no solo se mide por cómo resiste con el paso del tiempo, sino por la sensación que transmite.</p>
            <svg class="home-primary-card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="resistencia-title resistencia-desc">
              <title id="resistencia-title" data-i18n="home_primary_card_5_icon_title">Resistencia y sensación</title>
              <desc id="resistencia-desc" data-i18n="home_primary_card_5_icon_desc">Un escudo refinado protege una superficie continua y equilibrada.</desc>
              <path d="M32 7.5 49 14v13.2c0 11.7-6.6 20.7-17 28.8-10.4-8.1-17-17.1-17-28.8V14l17-6.5Z"></path>
              <path d="M21 35.5c3.1-3.2 6.8-4.8 11-4.8s7.9 1.6 11 4.8"></path>
              <path d="M20.5 38.5h23"></path>
              <path d="M24 42.5h16"></path>
              <path d="M32 17.5v8M28 21.5h8"></path>
              <path d="m29.2 18.7 5.6 5.6M34.8 18.7l-5.6 5.6"></path>
            </svg>
          </article>
        </div>

        <button
          class="feature-cards-arrow feature-cards-prev home-primary-cards-prev"
          type="button"
          aria-label="Ver tarjetas anteriores"
          data-i18n-aria-label="carousel_prev"
          data-carousel-prev
          hidden
        >
          <span aria-hidden="true">&lsaquo;</span>
        </button>

        <button
          class="feature-cards-arrow feature-cards-next home-primary-cards-next"
          type="button"
          aria-label="Ver más tarjetas"
          data-i18n-aria-label="carousel_next"
          data-carousel-next
          hidden
        >
          <span aria-hidden="true">&rsaquo;</span>
        </button>

        <div class="feature-cards-dots home-primary-cards-dots home-carousel-dots-on-light" aria-hidden="true" data-carousel-dots></div>
      </div>
    </section>

    <section class="feature-cards home-secondary-cards" aria-label="Novedades MyPerol" data-i18n-aria-label="feature_cards_aria">
      <div class="feature-cards-header home-secondary-cards-header">
        <p class="home-secondary-cards-heading" data-i18n="home_feature_cards_heading">La sensación de un espacio transformado.</p>
      </div>

      <div class="feature-cards-shell home-secondary-cards-shell">
        <div class="feature-cards-track home-secondary-cards-track">
          <article class="feature-card home-secondary-card">
            <span data-i18n="feature_card_label">Placeholder</span>
            <h2 data-i18n="feature_card_1_title">Superficie continua</h2>
            <p data-i18n="feature_card_1_text">Texto placeholder para describir una ventaja clave del acabado MyPerol.</p>
          </article>
          <article class="feature-card home-secondary-card">
            <span data-i18n="feature_card_label">Placeholder</span>
            <h2 data-i18n="feature_card_2_title">Acabado uniforme</h2>
            <p data-i18n="feature_card_2_text">Texto placeholder para explicar una mejora visual del espacio.</p>
          </article>
          <article class="feature-card home-secondary-card">
            <span data-i18n="feature_card_label">Placeholder</span>
            <h2 data-i18n="feature_card_3_title">Sensación premium</h2>
            <p data-i18n="feature_card_3_text">Texto placeholder para una tarjeta comercial sin imagen por ahora.</p>
          </article>
          <article class="feature-card home-secondary-card">
            <span data-i18n="feature_card_label">Placeholder</span>
            <h2 data-i18n="feature_card_4_title">Diseño limpio</h2>
            <p data-i18n="feature_card_4_text">Texto placeholder para destacar orden, amplitud y continuidad.</p>
          </article>
          <article class="feature-card home-secondary-card">
            <span data-i18n="feature_card_label">Placeholder</span>
            <h2 data-i18n="feature_card_5_title">Alta presencia</h2>
            <p data-i18n="feature_card_5_text">Texto placeholder para explicar el impacto del suelo en el ambiente.</p>
          </article>
        </div>

        <button
          class="feature-cards-arrow feature-cards-prev home-secondary-cards-prev"
          type="button"
          aria-label="Ver tarjetas anteriores"
          data-i18n-aria-label="carousel_prev"
          data-carousel-prev
          hidden
        >
          <span aria-hidden="true">&lsaquo;</span>
        </button>

        <button
          class="feature-cards-arrow feature-cards-next home-secondary-cards-next"
          type="button"
          aria-label="Ver más tarjetas"
          data-i18n-aria-label="carousel_next"
          data-carousel-next
          hidden
        >
          <span aria-hidden="true">&rsaquo;</span>
        </button>

        <div class="feature-cards-dots home-secondary-cards-dots home-carousel-dots-on-light" aria-hidden="true" data-carousel-dots></div>
      </div>
    </section>

    <SplineScroll />
  </main>
</BaseLayout>

<script>
  const sectionCornerControls = Array.from(
    document.querySelectorAll("[data-section-corner-controls]")
  ).filter((control) => control instanceof HTMLElement);

  const setSectionCornerControlsVisible = (control, isVisible) => {
    if (!(control instanceof HTMLElement)) return;

    control.classList.toggle("is-visible", isVisible);
    control.toggleAttribute("inert", !isVisible);
  };

  if (sectionCornerControls.length) {
    document.documentElement.classList.add("section-controls-reveal-enabled");
    sectionCornerControls.forEach((control) => setSectionCornerControlsVisible(control, false));
  }

  const initializeScrollReveal = () => {
    const revealItems = Array.from(document.querySelectorAll(".feature-card")).filter(
      (item) => item instanceof HTMLElement
    );

    if (!revealItems.length) return;

    document.documentElement.classList.add("reveal-enabled");

    revealItems.forEach((item, index) => {
      item.style.setProperty("--reveal-index", String(index % 5));
    });

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (prefersReducedMotion || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
      return;
    }

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        });
      },
      {
        root: null,
        rootMargin: "0px 0px -10% 0px",
        threshold: 0.18,
      }
    );

    window.requestAnimationFrame(() => {
      revealItems.forEach((item) => revealObserver.observe(item));
    });
  };

  const initializeFeatureCardsCarousel = (shell) => {
    const track = shell.querySelector(".feature-cards-track");
    const prevButton = shell.querySelector("[data-carousel-prev]");
    const nextButton = shell.querySelector("[data-carousel-next]");
    const dotsContainer = shell.querySelector("[data-carousel-dots]");

    if (
      !(track instanceof HTMLElement) ||
      !(prevButton instanceof HTMLButtonElement) ||
      !(nextButton instanceof HTMLButtonElement) ||
      !(dotsContainer instanceof HTMLElement)
    ) return;

    const cards = Array.from(track.querySelectorAll(".feature-card")).filter(
      (card) => card instanceof HTMLElement
    );

    const dots = cards.map((_, index) => {
      const dot = document.createElement("span");
      dot.className = "feature-cards-dot";
      dot.dataset.cardIndex = String(index);
      dotsContainer.append(dot);
      return dot;
    });
    let hoveredCardIndex = null;
    let hasInitializedArrowVisibility = false;

    const updateArrowCenter = () => {
      const referenceCard = cards[0];
      if (!referenceCard) return;

      const centerY = referenceCard.offsetTop + referenceCard.offsetHeight / 2;
      shell.style.setProperty("--carousel-arrow-center-y", `${centerY}px`);
    };

    const arrowResizeObserver = new ResizeObserver(updateArrowCenter);
    arrowResizeObserver.observe(track);
    cards.forEach((card) => arrowResizeObserver.observe(card));

    const getScrollStep = () => {
      const firstCard = track.querySelector(".feature-card");
      if (!(firstCard instanceof HTMLElement)) return 460;

      const styles = window.getComputedStyle(track);
      const gap = Number.parseFloat(styles.columnGap || styles.gap || "0");
      return firstCard.offsetWidth + gap;
    };

    const updateButtons = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      const scrollLeft = Math.max(0, track.scrollLeft);
      const previousArrowThreshold = 24;

      setArrowVisible(prevButton, scrollLeft > previousArrowThreshold);
      setArrowVisible(nextButton, scrollLeft < maxScroll - 1);
    };

    const setActiveDot = (index) => {
      const activeIndex = Math.max(0, Math.min(index, dots.length - 1));

      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle("is-active", dotIndex === activeIndex);
      });
    };

    const updateActiveDotFromScroll = () => {
      if (!cards.length) return;
      if (hoveredCardIndex !== null) {
        setActiveDot(hoveredCardIndex);
        return;
      }

      const trackRect = track.getBoundingClientRect();
      let mostVisibleIndex = 0;
      let mostVisibleWidth = 0;

      cards.forEach((card, index) => {
        const cardRect = card.getBoundingClientRect();
        const visibleLeft = Math.max(cardRect.left, trackRect.left);
        const visibleRight = Math.min(cardRect.right, trackRect.right);
        const visibleWidth = Math.max(0, visibleRight - visibleLeft);

        if (visibleWidth > mostVisibleWidth) {
          mostVisibleWidth = visibleWidth;
          mostVisibleIndex = index;
        }
      });

      setActiveDot(mostVisibleIndex);
    };

    const setArrowVisible = (button, isVisible) => {
      window.clearTimeout(Number(button.dataset.hideTimeout || 0));
      const wasVisible = button.dataset.arrowVisible === "true";

      if (isVisible) {
        button.hidden = false;
        button.classList.remove("is-hiding");
        button.dataset.arrowVisible = "true";
        return;
      }

      delete button.dataset.arrowVisible;

      if (button.hidden || button.classList.contains("is-hiding")) return;

      if (!hasInitializedArrowVisibility || !wasVisible) {
        button.hidden = true;
        button.classList.remove("is-hiding");
        delete button.dataset.hideTimeout;
        return;
      }

      button.classList.add("is-hiding");
      button.dataset.hideTimeout = String(
        window.setTimeout(() => {
          if (!button.classList.contains("is-hiding")) return;

          button.hidden = true;
          button.classList.remove("is-hiding");
          delete button.dataset.hideTimeout;
        }, 220)
      );
    };

    prevButton.addEventListener("click", () => {
      track.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
    });

    nextButton.addEventListener("click", () => {
      track.scrollBy({ left: getScrollStep(), behavior: "smooth" });
    });

    cards.forEach((card, index) => {
      card.addEventListener("mouseenter", () => {
        hoveredCardIndex = index;
        setActiveDot(index);
      });

      card.addEventListener("mouseleave", () => {
        hoveredCardIndex = null;
        updateActiveDotFromScroll();
      });

      card.addEventListener("focusin", () => {
        hoveredCardIndex = index;
        setActiveDot(index);
      });

      card.addEventListener("focusout", () => {
        hoveredCardIndex = null;
        updateActiveDotFromScroll();
      });
    });

    track.addEventListener(
      "scroll",
      () => {
        updateButtons();
        updateActiveDotFromScroll();
      },
      { passive: true }
    );

    window.addEventListener("resize", () => {
      updateButtons();
      updateActiveDotFromScroll();
      updateArrowCenter();
    });

    updateArrowCenter();
    updateButtons();
    hasInitializedArrowVisibility = true;
    shell.classList.add("is-carousel-ready");
    updateActiveDotFromScroll();
  };

  document.querySelectorAll(".feature-cards-shell").forEach((shell) => {
    if (shell instanceof HTMLElement) initializeFeatureCardsCarousel(shell);
  });

  initializeScrollReveal();

  // Fixed top controls switch contrast when they leave the dark hero image.
  const heroPlaceholder = document.querySelector(".hero-placeholder");

  if (heroPlaceholder instanceof HTMLElement) {
    let hasPendingToneUpdate = false;
    const lightToneThreshold = 65;

    const updateFixedControlsTone = () => {
      const heroBottom = heroPlaceholder.getBoundingClientRect().bottom;
      const isOverLightSurface = heroBottom <= lightToneThreshold;

      document.body.classList.toggle("controls-over-light", isOverLightSurface);
      hasPendingToneUpdate = false;
    };

    const requestFixedControlsToneUpdate = () => {
      if (hasPendingToneUpdate) return;

      hasPendingToneUpdate = true;
      window.requestAnimationFrame(updateFixedControlsTone);
    };

    window.addEventListener("scroll", requestFixedControlsToneUpdate, { passive: true });
    window.addEventListener("resize", requestFixedControlsToneUpdate);
    updateFixedControlsTone();
  }

  // Reusable transition between the video cover and the first card carousel.
  const entryScrollTarget = document.querySelector("[data-entry-scroll-target]");

  if (entryScrollTarget instanceof HTMLElement) {
    const entrySectionControls = entryScrollTarget.querySelector(
      '[data-section-corner-controls="primary-cards"]'
    );
    let isEntryScrollAnimating = false;
    let touchStartX = 0;
    let touchStartY = 0;
    let entryAnimationFrame = 0;
    let lastObservedScrollY = window.scrollY;
    let canDetectNativeScroll = false;
    const entryScrollDuration = 1200;
    const entryScrollTargetOffset = 0;
    const entryScrollTolerance = 12;
    const entryScrollReturnRange = 48;

    const easeInOutCubic = (progress) =>
      progress < 0.5
        ? 4 * progress * progress * progress
        : 1 - Math.pow(-2 * progress + 2, 3) / 2;

    const getEntryScrollTop = () => {
      const targetTop = entryScrollTarget.getBoundingClientRect().top + window.scrollY;

      return Math.max(0, targetTop - entryScrollTargetOffset);
    };

    const animateEntryScroll = (targetTop, onComplete = () => {}) => {
      const startTop = window.scrollY;
      const distance = targetTop - startTop;
      const startTime = performance.now();
      isEntryScrollAnimating = true;

      const step = (currentTime) => {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / entryScrollDuration, 1);
        const easedProgress = easeInOutCubic(progress);

        window.scrollTo(0, startTop + distance * easedProgress);

        if (progress < 1) {
          entryAnimationFrame = window.requestAnimationFrame(step);
        } else {
          isEntryScrollAnimating = false;
          entryAnimationFrame = 0;
          window.scrollTo(0, targetTop);
          onComplete();
        }
      };

      if (entryAnimationFrame) {
        window.cancelAnimationFrame(entryAnimationFrame);
      }

      entryAnimationFrame = window.requestAnimationFrame(step);
    };

    const scrollBetweenEntryFrames = (direction) => {
      if (isEntryScrollAnimating) return false;

      const entryScrollTop = getEntryScrollTop();

      if (direction === "down") {
        if (window.scrollY >= entryScrollTop - entryScrollTolerance) return false;

        setSectionCornerControlsVisible(entrySectionControls, false);
        animateEntryScroll(entryScrollTop, () => {
          setSectionCornerControlsVisible(entrySectionControls, true);
        });
        return true;
      }

      if (direction === "up") {
        const canReturnToHero =
          window.scrollY > entryScrollTolerance &&
          window.scrollY <= entryScrollTop + entryScrollReturnRange;

        if (!canReturnToHero) return false;

        setSectionCornerControlsVisible(entrySectionControls, false);
        animateEntryScroll(0);
        return true;
      }

      return false;
    };

    const preventInputDuringEntryScroll = (event) => {
      if (!isEntryScrollAnimating) return false;

      event.preventDefault();
      return true;
    };

    document.addEventListener(
      "wheel",
      (event) => {
        if (preventInputDuringEntryScroll(event)) return;
        if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;

        const direction = event.deltaY > 0 ? "down" : "up";
        if (!scrollBetweenEntryFrames(direction)) return;

        event.preventDefault();
      },
      { passive: false, capture: true }
    );

    document.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.touches[0]?.clientX ?? 0;
        touchStartY = event.touches[0]?.clientY ?? 0;
      },
      { passive: true, capture: true }
    );

    document.addEventListener(
      "touchmove",
      (event) => {
        if (preventInputDuringEntryScroll(event)) return;

        const touchX = event.touches[0]?.clientX ?? touchStartX;
        const touchY = event.touches[0]?.clientY ?? touchStartY;
        const deltaX = touchStartX - touchX;
        const deltaY = touchStartY - touchY;

        if (Math.abs(deltaY) <= 12 || Math.abs(deltaY) <= Math.abs(deltaX)) return;

        const direction = deltaY > 0 ? "down" : "up";
        if (!scrollBetweenEntryFrames(direction)) return;

        event.preventDefault();
      },
      { passive: false, capture: true }
    );

    document.addEventListener(
      "scroll",
      () => {
        const currentScrollY = window.scrollY;
        const scrollDelta = currentScrollY - lastObservedScrollY;
        lastObservedScrollY = currentScrollY;

        if (!canDetectNativeScroll || isEntryScrollAnimating) return;
        if (Math.abs(scrollDelta) < 1) return;

        scrollBetweenEntryFrames(scrollDelta > 0 ? "down" : "up");
      },
      { passive: true, capture: true }
    );

    document.addEventListener("keydown", (event) => {
      const isSpaceKey = event.key === " " || event.key === "Spacebar";
      const isDownKey =
        event.key === "ArrowDown" ||
        event.key === "PageDown" ||
        (isSpaceKey && !event.shiftKey);
      const isUpKey =
        event.key === "ArrowUp" ||
        event.key === "PageUp" ||
        event.key === "Home" ||
        (isSpaceKey && event.shiftKey);

      if (!isDownKey && !isUpKey) return;
      if (preventInputDuringEntryScroll(event)) return;
      if (!scrollBetweenEntryFrames(isDownKey ? "down" : "up")) return;

      event.preventDefault();
    });

    window.setTimeout(() => {
      lastObservedScrollY = window.scrollY;
      canDetectNativeScroll = true;

      const entryScrollTop = getEntryScrollTop();
      const isRestoredAtCards =
        Math.abs(window.scrollY - entryScrollTop) <= entryScrollTolerance;
      setSectionCornerControlsVisible(entrySectionControls, isRestoredAtCards);
    }, 0);
  }

  const flooringSection = document.querySelector("[data-flooring-scroll]");
  const flooringSectionControls = flooringSection?.querySelector(
    '[data-section-corner-controls="flooring"]'
  );

  if (
    flooringSection instanceof HTMLElement &&
    flooringSectionControls instanceof HTMLElement
  ) {
    let flooringControlsFrame = 0;

    const updateFlooringControlsVisibility = () => {
      const flooringBounds = flooringSection.getBoundingClientRect();
      const isFlooringScreenActive =
        flooringBounds.top <= 2 && flooringBounds.bottom > 0;

      setSectionCornerControlsVisible(flooringSectionControls, isFlooringScreenActive);
      flooringControlsFrame = 0;
    };

    const requestFlooringControlsUpdate = () => {
      if (flooringControlsFrame) return;
      flooringControlsFrame = window.requestAnimationFrame(updateFlooringControlsVisibility);
    };

    window.addEventListener("scroll", requestFlooringControlsUpdate, { passive: true });
    window.addEventListener("resize", requestFlooringControlsUpdate);
    updateFlooringControlsVisibility();
  }
</script>
