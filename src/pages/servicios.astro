---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="MyPerol - Servicios"
  description="Servicios de MyPerol."
  bodyClass="services-route"
>
  <main class="services-page reveal-enabled">
    <section class="hero-placeholder services-hero" aria-label="MyPerol">
      <img
        src="/assets/placeholder/placeholder-index.jpg"
        alt=""
        aria-hidden="true"
      />
    </section>

    <section class="feature-cards services-feature-cards" aria-label="Servicios MyPerol" data-i18n-aria-label="feature_cards_aria">
      <div class="feature-cards-header">
        <p id="services-feature-heading" class="services-feature-heading" data-i18n="feature_cards_heading">Explora posibilidades para tu espacio.</p>
        <div class="services-feature-subtitle">
          <p id="services-performance-copy"><b>Cada espacio exige un nivel de rendimiento diferente.</b></p>
          <p id="services-performance-copy-2">
            Nuestros sistemas epoxídicos <b>(MP SYSTEM)</b> han sido desarrollados para responder a las exigencias específicas de cada entorno, combinando resistencia, diseño y facilidad de mantenimiento para ofrecer el máximo rendimiento en distintos entornos de uso.
          </p>
        </div>
      </div>

      <div class="feature-cards-shell">
        <div class="feature-cards-track">
          <article class="feature-card service-card-expandable" tabindex="0" data-price-space="vivienda" data-service-technical="MP SYSTEM HOME es un pavimento continuo diseñado para viviendas, villas y proyectos residenciales donde la estética debe convivir con el uso diario. El sistema se configura según el soporte, las condiciones de la superficie y el acabado seleccionado, combinando preparación mecánica, imprimación de alta adherencia, capas de resina y protección final.&#10;&#10;El resultado es una superficie uniforme, sin las juntas visuales tradicionales, resistente al desgaste cotidiano y fácil de mantener. Disponible en acabados lisos, minerales o decorativos, permite integrar el pavimento con la arquitectura, la iluminación y el diseño interior del espacio.">
            <div class="service-card-media">
              <span>MyPerol</span>
              <img class="service-card-image" src="/assets/placeholder/tarjetas-placeholder.png" alt="" aria-hidden="true" />
            </div>
            <h2>HOME</h2>
            <p class="feature-card-services-text">Continuidad que transforma la forma de vivir cada espacio.</p>
          </article>

          <article class="feature-card service-card-expandable" tabindex="0" data-price-space="garaje" data-service-technical="MP SYSTEM GARAGE esta desarrollado para soportar el peso de los vehiculos, el transito frecuente, la abrasion y las exigencias propias de un garaje de uso intensivo. Su configuracion multicapa combina preparacion mecanica del soporte, imprimacion epoxi, refuerzo con aridos seleccionados, capa de resina y una terminacion protectora adaptada al nivel de uso.&#10;&#10;Puede incorporar acabados lisos, decorativos o antideslizantes, ofreciendo una superficie resistente, continua y facil de limpiar. Cada sistema se ajusta segun la exposicion solar, la presencia de aceites, las pendientes, los desagues y las condiciones de humedad del soporte.">
            <div class="service-card-media">
              <span>MyPerol</span>
              <img class="service-card-image" src="/assets/placeholder/tarjetas-placeholder.png" alt="" aria-hidden="true" />
            </div>
            <h2>GARAGE</h2>
            <p class="feature-card-services-text">Convierte tu garaje en un espacio a la altura de lo que guarda.</p>
          </article>

          <article class="feature-card service-card-expandable" tabindex="0" data-price-space="local-comercial" data-service-technical="MP SYSTEM BUSINESS esta disenado para espacios comerciales donde el pavimento forma parte de la experiencia del cliente. Clinicas, tiendas, restaurantes, oficinas, gimnasios y showrooms requieren superficies capaces de soportar transito diario sin perder coherencia estetica.&#10;&#10;El sistema combina una base tecnicamente preparada, capas continuas de altas prestaciones y una proteccion final seleccionada segun el uso, la limpieza y el nivel de deslizamiento requerido. Su acabado puede personalizarse en color, textura y grado de brillo para integrarse con la identidad visual del negocio y facilitar un mantenimiento eficiente.">
            <div class="service-card-media">
              <span>MyPerol</span>
              <img class="service-card-image" src="/assets/placeholder/tarjetas-placeholder.png" alt="" aria-hidden="true" />
            </div>
            <h2>BUSINESS</h2>
            <p class="feature-card-services-text">Un espacio mas limpio, mas solido y mas memorable.</p>
          </article>

          <article class="feature-card service-card-expandable" tabindex="0" data-price-space="industria" data-service-technical="MP SYSTEM INDUSTRY esta desarrollado para entornos sometidos a cargas, abrasion, transito tecnico y limpieza frecuente. Cada solucion se disena a partir de las exigencias reales de la actividad: tipo de maquinaria, intensidad de uso, exposicion quimica, temperatura, seguridad y tiempo disponible para la ejecucion.&#10;&#10;Segun el proyecto, puede configurarse como sistema multicapa, autonivelante o reforzado con arido. Su estructura proporciona adherencia, resistencia mecanica y una textura adaptada al entorno de trabajo, creando un pavimento fiable, mantenible y preparado para un uso profesional prolongado.">
            <div class="service-card-media">
              <span>MyPerol</span>
              <img class="service-card-image" src="/assets/placeholder/tarjetas-placeholder.png" alt="" aria-hidden="true" />
            </div>
            <h2>INDUSTRY</h2>
            <p class="feature-card-services-text">Rendimiento continuo para espacios que no pueden detenerse.</p>
          </article>

          <article class="feature-card service-card-expandable" tabindex="0" data-price-space="exterior" data-service-technical="MP SYSTEM OUTDOOR esta concebido para terrazas, accesos, porches y zonas expuestas donde el pavimento debe responder a cambios termicos, radiacion solar, agua y transito exterior. No se aplica como una solucion generica: cada superficie se estudia segun su soporte, exposicion, pendientes, juntas y sistema de drenaje.&#10;&#10;La solucion puede incorporar capas de adherencia, regularizacion, revestimientos compatibles con exterior y terminaciones resistentes a la radiacion ultravioleta. El nivel de textura se adapta al uso previsto para mejorar la seguridad sin renunciar a una superficie integrada con la arquitectura.">
            <div class="service-card-media">
              <span>MyPerol</span>
              <img class="service-card-image" src="/assets/placeholder/tarjetas-placeholder.png" alt="" aria-hidden="true" />
            </div>
            <h2>OUTDOOR</h2>
            <p class="feature-card-services-text">El exterior tambien puede sentirse continuo.</p>
          </article>
        </div>

        <button
          class="feature-cards-arrow feature-cards-prev"
          type="button"
          aria-label="Ver tarjetas anteriores"
          data-i18n-aria-label="carousel_prev"
          data-carousel-prev
          hidden
        >
          <span aria-hidden="true">&lsaquo;</span>
        </button>

        <button
          class="feature-cards-arrow feature-cards-next"
          type="button"
          aria-label="Ver mas tarjetas"
          data-i18n-aria-label="carousel_next"
          data-carousel-next
          hidden
        >
          <span aria-hidden="true">&rsaquo;</span>
        </button>

        <div class="feature-cards-dots" aria-hidden="true" data-carousel-dots></div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const initializeScrollReveal = () => {
    const revealItems = Array.from(document.querySelectorAll(".feature-card")).filter(
      (item) => item instanceof HTMLElement
    );

    if (!revealItems.length) return;

    revealItems.forEach((item, index) => {
      item.style.setProperty("--reveal-index", String(index % 5));
    });

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (prefersReducedMotion || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
      return;
    }

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        });
      },
      {
        root: null,
        rootMargin: "0px 0px -10% 0px",
        threshold: 0.18,
      }
    );

    window.requestAnimationFrame(() => {
      revealItems.forEach((item) => revealObserver.observe(item));
    });
  };

  const initializeFeatureCardsCarousel = (shell) => {
    const track = shell.querySelector(".feature-cards-track");
    const prevButton = shell.querySelector("[data-carousel-prev]");
    const nextButton = shell.querySelector("[data-carousel-next]");
    const dotsContainer = shell.querySelector("[data-carousel-dots]");

    if (
      !(track instanceof HTMLElement) ||
      !(prevButton instanceof HTMLButtonElement) ||
      !(nextButton instanceof HTMLButtonElement) ||
      !(dotsContainer instanceof HTMLElement)
    ) return;

    const cards = Array.from(track.querySelectorAll(".feature-card")).filter(
      (card) => card instanceof HTMLElement
    );

    const dots = cards.map((_, index) => {
      const dot = document.createElement("span");
      dot.className = "feature-cards-dot";
      dot.dataset.cardIndex = String(index);
      dotsContainer.append(dot);
      return dot;
    });
    let hoveredCardIndex = null;
    let hasInitializedArrowVisibility = false;

    const getScrollStep = () => {
      const firstCard = track.querySelector(".feature-card");
      if (!(firstCard instanceof HTMLElement)) return 460;

      const styles = window.getComputedStyle(track);
      const gap = Number.parseFloat(styles.columnGap || styles.gap || "0");
      return firstCard.offsetWidth + gap;
    };

    const setArrowVisible = (button, isVisible) => {
      window.clearTimeout(Number(button.dataset.hideTimeout || 0));
      const wasVisible = button.dataset.arrowVisible === "true";

      if (isVisible) {
        button.hidden = false;
        button.classList.remove("is-hiding");
        button.dataset.arrowVisible = "true";
        return;
      }

      delete button.dataset.arrowVisible;

      if (button.hidden || button.classList.contains("is-hiding")) return;

      if (!hasInitializedArrowVisibility || !wasVisible) {
        button.hidden = true;
        button.classList.remove("is-hiding");
        delete button.dataset.hideTimeout;
        return;
      }

      button.classList.add("is-hiding");
      button.dataset.hideTimeout = String(
        window.setTimeout(() => {
          if (!button.classList.contains("is-hiding")) return;

          button.hidden = true;
          button.classList.remove("is-hiding");
          delete button.dataset.hideTimeout;
        }, 220)
      );
    };

    const updateButtons = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      const scrollLeft = Math.max(0, track.scrollLeft);
      const previousArrowThreshold = 24;

      setArrowVisible(prevButton, scrollLeft > previousArrowThreshold);
      setArrowVisible(nextButton, scrollLeft < maxScroll - 1);
    };

    const setActiveDot = (index) => {
      const activeIndex = Math.max(0, Math.min(index, dots.length - 1));

      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle("is-active", dotIndex === activeIndex);
      });
    };

    const updateActiveDotFromScroll = () => {
      if (!cards.length) return;
      if (hoveredCardIndex !== null) {
        setActiveDot(hoveredCardIndex);
        return;
      }

      const trackRect = track.getBoundingClientRect();
      let mostVisibleIndex = 0;
      let mostVisibleWidth = 0;

      cards.forEach((card, index) => {
        const cardRect = card.getBoundingClientRect();
        const visibleLeft = Math.max(cardRect.left, trackRect.left);
        const visibleRight = Math.min(cardRect.right, trackRect.right);
        const visibleWidth = Math.max(0, visibleRight - visibleLeft);

        if (visibleWidth > mostVisibleWidth) {
          mostVisibleWidth = visibleWidth;
          mostVisibleIndex = index;
        }
      });

      setActiveDot(mostVisibleIndex);
    };

    prevButton.addEventListener("click", () => {
      track.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
    });

    nextButton.addEventListener("click", () => {
      track.scrollBy({ left: getScrollStep(), behavior: "smooth" });
    });

    cards.forEach((card, index) => {
      card.addEventListener("mouseenter", () => {
        hoveredCardIndex = index;
        setActiveDot(index);
      });

      card.addEventListener("mouseleave", () => {
        hoveredCardIndex = null;
        updateActiveDotFromScroll();
      });

      card.addEventListener("focusin", () => {
        hoveredCardIndex = index;
        setActiveDot(index);
      });

      card.addEventListener("focusout", () => {
        hoveredCardIndex = null;
        updateActiveDotFromScroll();
      });
    });

    track.addEventListener(
      "scroll",
      () => {
        updateButtons();
        updateActiveDotFromScroll();
      },
      { passive: true }
    );

    window.addEventListener("resize", () => {
      updateButtons();
      updateActiveDotFromScroll();
    });

    updateButtons();
    hasInitializedArrowVisibility = true;
    shell.classList.add("is-carousel-ready");
    updateActiveDotFromScroll();
  };

  document.querySelectorAll(".feature-cards-shell").forEach((shell) => {
    if (shell instanceof HTMLElement) initializeFeatureCardsCarousel(shell);
  });

  const initializeServiceCardExpansion = () => {
    const cards = Array.from(document.querySelectorAll(".services-feature-cards .service-card-expandable")).filter(
      (card) => card instanceof HTMLElement
    );

    if (!cards.length) return;

    let activeOverlay = null;
    let isClosing = false;

    const closeExpandedCard = () => {
      if (!activeOverlay || isClosing) return;

      isClosing = true;
      activeOverlay.classList.add("is-closing");
      activeOverlay.classList.remove("is-blurred");
      activeOverlay.classList.remove("is-open");

      activeOverlay.addEventListener(
        "transitionend",
        (event) => {
          if (event.target !== activeOverlay) return;

          activeOverlay?.remove();
          activeOverlay = null;
          isClosing = false;
        },
        { once: true }
      );
    };

    const openExpandedCard = (card) => {
      if (activeOverlay || isClosing) return;

      const label = card.querySelector("span")?.textContent?.trim() || "MyPerol";
      const title = card.querySelector("h2")?.textContent?.trim() || "";
      const text = card.querySelector("p")?.textContent?.trim() || "";
      const technicalText = card.dataset.serviceTechnical || text;
      const image = card.querySelector(".service-card-image");
      const imageSrc = image instanceof HTMLImageElement ? image.currentSrc || image.src : "";
      const priceSpace = card.dataset.priceSpace || "";

      activeOverlay = document.createElement("div");
      activeOverlay.className = "service-expanded-overlay";
      activeOverlay.innerHTML = `
        <article class="service-expanded-card" role="dialog" aria-modal="true" aria-label="${label} ${title}">
          <div class="service-expanded-media">
            <div class="service-expanded-media-frame">
              <img src="${imageSrc}" alt="" aria-hidden="true" />
            </div>
            <p class="service-expanded-summary">${text}</p>
          </div>
          <div class="service-expanded-content">
            <p class="service-expanded-label">${label}</p>
            <h2 class="service-expanded-title">${title}</h2>
            <p class="service-expanded-copy">${technicalText}</p>
            <button class="service-expanded-action" type="button" data-service-price-space="${priceSpace}">Solicitar precio</button>
            <button class="service-expanded-composition" type="button"><span class="composition-shift-label">Conoce la composicion</span><span class="composition-shift-arrow" aria-hidden="true">&rarr;</span></button>
          </div>
        </article>
      `;

      document.body.append(activeOverlay);
      const expandedCard = activeOverlay.querySelector(".service-expanded-card");
      const expandedImage = activeOverlay.querySelector(".service-expanded-media-frame img");

      if (!(expandedCard instanceof HTMLElement)) return;

      const requestPriceButton = activeOverlay.querySelector("[data-service-price-space]");

      requestPriceButton?.addEventListener("click", () => {
        if (!(requestPriceButton instanceof HTMLElement)) return;

        const selectedSpace = requestPriceButton.dataset.servicePriceSpace || "";
        sessionStorage.removeItem("myperol-price-calculator");
        window.location.href = `/precios?reset=1&space=${encodeURIComponent(selectedSpace)}`;
      });

      activeOverlay.addEventListener("click", (event) => {
        if (event.target === activeOverlay) closeExpandedCard();
      });

      const openOverlay = () => {
        window.requestAnimationFrame(() => {
          activeOverlay?.classList.add("is-open");
          activeOverlay?.classList.add("is-blurred");
        });
      };

      if (expandedImage instanceof HTMLImageElement && "decode" in expandedImage) {
        expandedImage.decode().then(openOverlay).catch(openOverlay);
      } else {
        openOverlay();
      }
    };

    cards.forEach((card) => {
      card.setAttribute("role", "button");
      card.setAttribute("aria-label", `Abrir ${card.querySelector("h2")?.textContent?.trim() || "servicio"}`);

      card.addEventListener("click", () => openExpandedCard(card));
      card.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;

        event.preventDefault();
        openExpandedCard(card);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeExpandedCard();
    });
  };

  initializeServiceCardExpansion();

  initializeScrollReveal();

  const servicesHero = document.querySelector(".services-hero");

  if (servicesHero instanceof HTMLElement) {
    let hasPendingToneUpdate = false;
    const lightToneThreshold = 65;

    const updateFixedControlsTone = () => {
      const heroBottom = servicesHero.getBoundingClientRect().bottom;
      const isOverLightSurface = heroBottom <= lightToneThreshold;

      document.body.classList.toggle("controls-over-light", isOverLightSurface);
      hasPendingToneUpdate = false;
    };

    const requestFixedControlsToneUpdate = () => {
      if (hasPendingToneUpdate) return;

      hasPendingToneUpdate = true;
      window.requestAnimationFrame(updateFixedControlsTone);
    };

    window.addEventListener("scroll", requestFixedControlsToneUpdate, { passive: true });
    window.addEventListener("resize", requestFixedControlsToneUpdate);
    updateFixedControlsTone();
  }
</script>
